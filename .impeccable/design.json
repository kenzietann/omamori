      "html": "<button class=\"ds-button-primary\">Start a run</button>",
      "css": ".ds-button-primary{font-family:\"Public Sans\",sans-serif;min-height:44px;padding:10px 16px;border:1px solid var(--line,#d6ddd7);border-radius:5px;font-size:13px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background 150ms var(--ease,cubic-bezier(.2,.8,.2,1)),border-color 150ms var(--ease,cubic-bezier(.2,.8,.2,1)),transform 150ms var(--ease,cubic-bezier(.2,.8,.2,1));background:var(--accent,#155bd7);color:var(--accent-ink,#fff);border-color:var(--accent,#155bd7);}.ds-button-primary:hover{filter:brightness(.93)}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed;transform:none}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#155bd7);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
