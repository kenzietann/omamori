  "narrative": {
    "northStar": "The Reference Workspace",
    "overview": "The Reference Workspace makes investigation feel precise and grounded: warm light surfaces, green-black ink, cobalt selection and aligned records. Its matching dark theme preserves the same geometry, reading order and semantic distinctions. Light is the default; the user chooses when to switch.\n\nOmamori keeps its existing O+M mark and concise English. Public Sans gives the application a clear, modern voice; dividers and restrained state feedback do the structural work. This is an operational application, so information density follows the task and motion supports changes of state.",
    "keyCharacteristics": [
      "Warm neutral surfaces and strong reading contrast.",
      "One clear selection accent, separate from severity colors.",
      "Aligned records, adjacent evidence and visible provenance.",
      "Self-hosted assets and matching light/dark geometry."
    ],
    "rules": [
      {
        "name": "Selection Is Not Severity",
        "body": "Use the accent for navigation, actions and selection. Use labeled severity colors for alert level and status; color alone never carries the meaning.",
        "section": "colors"
      },
      {
        "name": "Evidence Stays Legible",
        "body": "Keep identifiers and source text selectable and allow long values to wrap. Use monospace for raw evidence, not as a substitute for the main reading face.",
        "section": "typography"
      },
      {
        "name": "Flat Working Surfaces",
        "body": "Working panels use surface tone and borders. Reserve the ambient shadow for the modal dialog; the active tab underline is a state indicator, not elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the existing Omamori name and O+M mark, with the matching icon for each theme.",
      "Do preserve labeled severity, visible keyboard focus, reduced-motion behavior and readable source paths.",
      "Do disclose the selected run, displayed alert count and UTC bucket intervals beside charts.",
      "Do keep real evidence, explicit uncertainty and guarded actions intact when changing presentation."
    ],
    "donts": [
      "Don't present synthetic fixtures or the latest retained sample as complete production telemetry.",
      "Don't replace adjacent evidence with a decorative dashboard statistic or hide its provenance.",
      "Don't add remote fonts or scripts to this local application.",
      "Don't turn marketing hero or perpetual-motion conventions into requirements for operational screens."
    ]
  }
}
